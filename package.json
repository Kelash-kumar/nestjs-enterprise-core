{
  "name": "nestjs-auth-foundation",
  "version": "0.5.1",
  "private": true,
  "description": "Reusable NestJS backend foundation \u2014 phase 5",
  "engines": {
    "node": ">=22.13 <23 || >=24.11"
  },
  "scripts": {
    "build": "node init && tsc -p tsconfig.build.json",
    "start": "node init && node dist/main.js",
    "start:dev": "node init && nodemon --watch src --ext ts --exec \"ts-node src/main.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --testPathPattern=src",
    "test:e2e": "jest --runInBand --testPathPattern=test",
    "test:coverage": "jest --runInBand --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "db:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-postgres.ps1",
    "db:create": "ts-node scripts/database.ts create",
    "db:migrate": "ts-node scripts/database.ts migrate",
    "db:revert": "ts-node scripts/database.ts revert",
    "db:status": "ts-node scripts/database.ts status",
    "db:schema-check": "ts-node scripts/database.ts schema-check",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/core/database/data-source.ts",
    "test:database": "jest --runInBand --testPathPattern=database --config jest.database.config.cjs",
    "check:all": "npm run check && npm run test:database",
    "auth:keys": "ts-node scripts/auth-keys.ts",
    "auth:preview": "ts-node scripts/verification-preview.ts",
    "mail:worker": "ts-node src/main-mail-worker.ts",
    "mail:once": "ts-node src/main-mail-worker.ts --once",
    "mail:worker:prod": "node dist/main-mail-worker.js",
    "mail:status": "ts-node scripts/outbox.ts status",
    "mail:retry": "ts-node scripts/outbox.ts retry",
    "auth:recovery-preview": "ts-node scripts/recovery-preview.ts",
    "authorization:bootstrap": "ts-node scripts/authorization.ts bootstrap",
    "authorization:grant": "ts-node scripts/authorization.ts grant",
    "db:seed": "ts-node scripts/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.11",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.2.11",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.11",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.0.0",
    "argon2": "^0.45.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie": "^1.1.1",
    "dotenv": "^18.0.10",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "joi": "^18.0.0",
    "nestjs-pino": "^4.0.0",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1",
    "pino": "^9.0.0",
    "pino-http": "^10.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@nestjs/testing": "^11.2.11",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/smtp-server": "^3.5.13",
    "@types/supertest": "^6.0.0",
    "eslint": "^9.0.0",
    "jest": "29.7.0",
    "jest-util": "^29.7.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.0.0",
    "smtp-server": "^3.21.6",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0"
  }
}
